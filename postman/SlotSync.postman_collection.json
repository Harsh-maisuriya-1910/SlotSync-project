    {
      "name": "Counsellor",
      "item": [
        {
          "name": "Create Slot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.expect(pm.response.code).to.eql(201));",
                  "pm.environment.set(\"slotId\", pm.response.json().data.id);",
                  "pm.environment.set(\"slotVersion\", pm.response.json().data.version);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{counsellorAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"{{$isoTimestampPlusDays}}\",\n  \"endTime\": \"{{$isoTimestampPlusDaysEnd}}\",\n  \"capacity\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/slots",
              "host": ["{{baseUrl}}"],
              "path": ["api", "slots"]
            },
            "description": "Replace the ISO timestamps with real future dates before sending (Postman dynamic vars are placeholders). Slot must start more than 30 minutes from now to be bookable."
          },
          "response": []
        },
        {
          "name": "Update Slot (Optimistic Concurrency)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set(\"slotVersion\", pm.response.json().data.version);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{counsellorAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedVersion\": {{slotVersion}},\n  \"capacity\": 10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/slots/{{slotId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "slots", "{{slotId}}"]
            },
            "description": "Stale expectedVersion returns 409 SLOT_VERSION_CONFLICT."
          },
          "response": []
        },
        {
          "name": "View All Slots",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{counsellorAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/slots?limit=20&cursor=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "slots"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "cursor", "value": "", "description": "Opaque cursor from pagination.nextCursor; empty = first page" }
              ]
            }
          },
          "response": []
        },
