    {
      "name": "Failure Cases",
      "item": [
        {
          "name": "401 Unauthorized - missing token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 with code\", () => {",
                  "  pm.expect(pm.response.code).to.eql(401);",
                  "  pm.expect(pm.response.json().code).to.eql(\"UNAUTHENTICATED\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/my-bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "my-bookings"]
            }
          },
          "response": []
        },
        {
          "name": "403 Forbidden - student hits admin endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 with code\", () => {",
                  "  pm.expect(pm.response.code).to.eql(403);",
                  "  pm.expect(pm.response.json().code).to.eql(\"ACCESS_FORBIDDEN\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/analytics/admin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "admin"]
            }
          },
          "response": []
        },
        {
          "name": "409 Conflict - duplicate booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 with domain code\", () => {",
                  "  pm.expect([409].includes(pm.response.code)).to.be.true;"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            },
            "description": "Second booking for the same slot without Idempotency-Key returns 409 BOOKING_ALREADY_EXISTS."
          },
          "response": []
        },
        {
          "name": "422 Validation - invalid booking payload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 validation error\", () => {",
                  "  pm.expect(pm.response.code).to.eql(422);",
                  "  pm.expect(pm.response.json().errors.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          },
          "response": []
        },
        {
          "name": "422 Invalid Status Transition",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{counsellorAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/counsellor/bookings/{{cancelledBookingId}}/outcome",
              "host": ["{{baseUrl}}"],
              "path": ["api", "counsellor", "bookings", "{{cancelledBookingId}}", "outcome"]
            },
            "description": "Marking a CANCELLED booking as attended returns 422 INVALID_STATUS_TRANSITION. Set cancelledBookingId manually or via a cancelled booking's id."
          },
          "response": []
