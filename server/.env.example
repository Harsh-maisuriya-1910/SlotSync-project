# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/slotsync

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# Bootstrap admin (used by npm run seed fallback / initial setup)
ADMIN_NAME=SlotSync Admin
ADMIN_EMAIL=admin@slotsync.dev
ADMIN_PASSWORD=Password123!

# CORS: comma-separated allowlist of frontend origins
CLIENT_URL=http://localhost:5173

# Login rate limiting (POST /api/auth/login)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10